{
  "format": "whirligig-aircraft/1",
  "name": "Tricopter",
  "author": "whirligig",
  "version": "1",
  "notes": "Three 6x4 props: a counter-rotating front pair and one rear rotor on a yaw tilt servo (PLAN Phase 3). The rear prop's drive reaction is unbalanced by design, so in a steady hover the stabilizer's yaw integrator holds the tail servo a few degrees over to cancel it - exactly what a real tricopter's tail does. The mixer is written out by hand because yaw lives on the servo channel, not on motor speeds.",
  "parts": [
    { "type": "mass", "name": "frame", "position": [-0.02, 0, 0], "mass": 0.22, "size": [0.34, 0.26, 0.035] },
    { "type": "battery", "name": "pack", "position": [0, 0, -0.012], "cells": 4, "chemistry": "lipo", "capacity": 1.5, "resistance": 0.025, "bus": "main", "mass": 0.16 },

    { "type": "prop", "name": "pFR", "position": [0.12, 0.14, -0.018], "axis": [0, 0, -1], "spin": 1, "diameter": 0.1524, "pitch": 0.1016, "blades": 2, "mass": 0.005 },
    { "type": "prop", "name": "pFL", "position": [0.12, -0.14, -0.018], "axis": [0, 0, -1], "spin": -1, "diameter": 0.1524, "pitch": 0.1016, "blades": 2, "mass": 0.005 },
    { "type": "prop", "name": "pR", "position": [-0.2, 0, -0.018], "axis": [0, 0, -1], "spin": 1, "diameter": 0.1524, "pitch": 0.1016, "blades": 2, "mass": 0.005,
      "tilt": { "channel": "tiltYaw", "axis": [1, 0, 0], "range": 0.4, "rate": 8 } },

    { "type": "motor", "name": "m1", "position": [0.12, 0.14, -0.008], "shaft": "pFR", "channel": "m1", "kv": 1700, "resistance": 0.1, "idleCurrent": 0.5, "maxCurrent": 30, "bus": "main", "mass": 0.028 },
    { "type": "motor", "name": "m2", "position": [0.12, -0.14, -0.008], "shaft": "pFL", "channel": "m2", "kv": 1700, "resistance": 0.1, "idleCurrent": 0.5, "maxCurrent": 30, "bus": "main", "mass": 0.028 },
    { "type": "motor", "name": "m3", "position": [-0.2, 0, -0.008], "shaft": "pR", "channel": "m3", "kv": 1700, "resistance": 0.1, "idleCurrent": 0.5, "maxCurrent": 30, "bus": "main", "mass": 0.028 },

    { "type": "drag", "name": "frame drag", "position": [0, 0, 0], "area": 0.003 },

    { "type": "gear", "name": "legFR", "position": [0.12, 0.14, 0.04], "stiffness": 4000, "damping": 35 },
    { "type": "gear", "name": "legFL", "position": [0.12, -0.14, 0.04], "stiffness": 4000, "damping": 35 },
    { "type": "gear", "name": "legR", "position": [-0.2, 0, 0.04], "stiffness": 4000, "damping": 35 }
  ],
  "mixer": {
    "rules": [
      { "input": "throttle", "channel": "m1", "gain": 1 },
      { "input": "throttle", "channel": "m2", "gain": 1 },
      { "input": "throttle", "channel": "m3", "gain": 1 },

      { "input": "roll", "channel": "m1", "gain": -0.5 },
      { "input": "roll", "channel": "m2", "gain": 0.5 },

      { "input": "pitch", "channel": "m1", "gain": 0.35 },
      { "input": "pitch", "channel": "m2", "gain": 0.35 },
      { "input": "pitch", "channel": "m3", "gain": -0.5 },

      { "input": "yaw", "channel": "tiltYaw", "gain": -1 }
    ]
  },
  "stabilizer": { "mode": "angle", "yaw": { "p": 0.6, "i": 0.8, "d": 0 } }
}
